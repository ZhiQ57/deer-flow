{
  "$comment": "VSSAG 位于 mcp-extensions/vssag。启用时须安装独立服务环境及 Gateway 基础包，将 middlewares.vssag_directory:VssagDirectoryMiddleware 加入 middlewares，将 vssag_mcp_server.interceptor:build_context_interceptor 加入 mcpInterceptors，并启用 mcpServers.vssag。SDK 凭据放服务 .env.dev，MCP 按需由 DeerFlow 通过 stdio 自动启动。操作步骤见 docs/guide/vssag-mcp.md。",
  "middlewares": [],
  "mcpInterceptors": [],
  "mcpServers": {
    "vfssql": {
      "enabled": false,
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp",
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "oauth": {
        "enabled": true,
        "token_url": "http://localhost:8333/realms/mcp/protocol/openid-connect/token",
        "grant_type": "client_credentials",
        "client_id": "backend-mcp-server",
        "client_secret": "$VFSSQL_OAUTH_CLIENT_SECRET",
        "scope": "vfssql:read",
        "refresh_skew_seconds": 60
      },
      "description": "VFSSQL 只读 SQL Schema、字段值和业务规则检索；虚拟目录操作，不执行数据库 SQL。接入见 docs/guide/vfssql-http-mcp.md。",
      "routing": {
        "mode": "prefer",
        "priority": 100,
        "keywords": ["VFSSQL", "vfssql", "SQL Schema", "表结构", "字段", "业务规则", "字段值"]
      }
    },
    "vssag": {
      "enabled": false,
      "type": "stdio",
      "command": "$VSSAG_MCP_PYTHON",
      "args": ["-I", "-m", "vssag_mcp_server.server", "--config", "$VSSAG_MCP_CONFIG", "--root", "/home/mnt/knowledge"],
      "env": {"APP_ENV": "dev", "PYTHONUTF8": "1", "PYTHONIOENCODING": "utf-8"},
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 45,
      "description": "知识库检索 MCP 服务，提供文件目录展示和检索功能",
      "routing": {"mode": "prefer", "priority": 80, "keywords": ["知识库", "文档检索", "VSSAG"]}
    },
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 60,
      "description": "GitHub MCP server for repository operations"
    },
    "parallel-search": {
      "enabled": false,
      "type": "http",
      "url": "https://search.parallel.ai/mcp",
      "description": "Optional anonymous Parallel Search tools for web search and fetching requested URLs"
    },
    "openviking": {
      "enabled": false,
      "type": "http",
      "url": "http://127.0.0.1:1933/mcp",
      "headers": {
        "X-API-Key": "$OPENVIKING_API_KEY"
      },
      "description": "Official OpenViking tools for explicit memory and resource operations"
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://localhost/mydb"],
      "env": {},
      "description": "PostgreSQL database access",
      "routing": {
        "mode": "prefer",
        "priority": 50,
        "keywords": ["database", "SQL", "table", "订单", "用户"]
      },
      "tools": {
        "query": {
          "routing": {
            "mode": "prefer",
            "priority": 100,
            "keywords": ["查库", "订单表", "指标"]
          }
        }
      }
    },
    "tablerag": {
      "enabled": false,
      "type": "stdio",
      "command": "python",
      "args": ["-m", "table_rag.mcp", "--transport", "stdio"],
      "env": {
        "TABLERAG_MCP_CONFIG": "$TABLERAG_CONFIG",
        "TABLERAG_MCP_INDEX_DSN": "$TABLERAG_MCP_INDEX_DSN"
      },
      "tool_call_timeout": 60,
      "tool_name_prefix": false,
      "description": "TableRAG MCP server for DataAgent Text2SQL context retrieval",
      "routing": {
        "mode": "prefer",
        "priority": 90,
        "keywords": ["Text2SQL", "NL2SQL", "schema", "table_rag", "数据表", "字段", "查库"]
      }
    },
    "sql-execute": {
      "enabled": false,
      "type": "http",
      "url": "$SQL_EXECUTE_MCP_URL",
      "tool_name_prefix": false,
      "description": "External read-only SQL execution MCP server",
      "routing": {
        "mode": "prefer",
        "priority": 95,
        "keywords": ["SQL", "查询", "数据库", "执行查询"]
      }
    },
    "sqltable-rag": {
      "enabled": false,
      "type": "http",
      "url": "$SQLTABLE_RAG_MCP_URL",
      "tool_name_prefix": false,
      "description": "External TableRAG schema retrieval MCP server",
      "routing": {
        "mode": "prefer",
        "priority": 90,
        "keywords": ["Text2SQL", "NL2SQL", "表结构", "字段", "业务口径"]
      }
    },
    "long-running-reports": {
      "enabled": false,
      "type": "http",
      "url": "https://reports.example.com/mcp",
      "description": "Example ordinary MCP background-task contract",
      "session_init_timeout": 60,
      "tool_call_timeout": 60,
      "task_toolsets": [
        {
          "name": "report-generation",
          "submit_tool": "submit_report",
          "status_tool": "get_report_status",
          "cancel_tool": "cancel_report"
        }
      ]
    }
  },
  "skills": {}
}
