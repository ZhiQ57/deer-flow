{
  "mcpServers": {
    "vfssql": {
        "enabled": true,
        "type": "http",
        "url": "http://127.0.0.1:8765/mcp",
        "oauth": {
            "enabled": true,
            "token_url": "http://127.0.0.1:8333/realms/mcp/protocol/openid-connect/token",
            "grant_type": "client_credentials",
            "client_id": "backend-mcp-server",
            "client_secret": "$VFSSQL_OAUTH_CLIENT_SECRET",
            "scope": "vfssql:read",
            "refresh_skew_seconds": 60
        },
        "headers": {},
        "tool_name_prefix": true,
        "session_init_timeout": 60,
        "description": "",
        "routing": {
            "mode": "prefer",
            "priority": 100,
            "keywords": ["SQL Schema Recall"]
        }
    }
  }
}