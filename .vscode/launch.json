{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DeerFlow: Windows本地调试 Gateway",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "debugAdapterPython": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "debugLauncherPython": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "module": "uvicorn",
      "args": [
        "app.gateway.app:app",
        "--host",
        "0.0.0.0",
        "--port",
        "7001",
        "--loop",
        "asyncio:SelectorEventLoop"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "PYTHONPATH": "."
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true
    },
    {
      "name": "DeerFlow: Windows本地调试 Frontend",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/frontend/scripts/dev.mjs",
      "args": ["--hostname", "0.0.0.0", "--port", "7000"],
      "cwd": "${workspaceFolder}/frontend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "DEER_FLOW_INTERNAL_GATEWAY_BASE_URL": "http://127.0.0.1:7001"
      },
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true
    }
  ],
  "compounds": [
    {
      "name": "DeerFlow: Windows本地 Gateway + Frontend",
      "configurations": [
        "DeerFlow: Windows本地调试 Gateway",
        "DeerFlow: Windows本地调试 Frontend"
      ]
    }
  ]
}
