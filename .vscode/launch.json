{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DeerFlow: Windows本地调试 Gateway",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "debugAdapterPython": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "debugLauncherPython": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "module": "uvicorn",
      "args": [
        "app.gateway.app:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8001",
        "--loop",
        "asyncio:SelectorEventLoop"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "PYTHONPATH": "."
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true
    }
  ]
}
